"use client";

import { useEffect, useState } from "react";
import {
  Bell,
  CarFront,
  ChevronRight,
  FileText,
  Info,
  Settings,
} from "lucide-react";
import { BottomNavigation } from "@/components/mobile/BottomNavigation";
import { getVehicleMileage } from "@/lib/storage/vehicleStorage";
import styles from "./profile.module.css";

function formatMileage(value: number): string {
  return new Intl.NumberFormat("es-EC").format(value);
}

function formatUpdatedAt(value: string): string {
  if (!value) {
    return "Sin actualizaciones";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "Sin actualizaciones";
  }

  return new Intl.DateTimeFormat("es-EC", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(date);
}

const menuItems = [
  {
    label: "Mi vehículo",
    description: "Datos principales del vehículo",
    icon: CarFront,
  },
  {
    label: "Documentos",
    description: "Matrícula, seguro y manual",
    icon: FileText,
  },
  {
    label: "Notificaciones",
    description: "Recordatorios y alertas",
    icon: Bell,
  },
  {
    label: "Configuración",
    description: "Preferencias de la aplicación",
    icon: Settings,
  },
  {
    label: "Acerca de SWM Care",
    description: "Información y versión",
    icon: Info,
  },
];

export default function ProfilePage() {
  const [mileage, setMileage] = useState(89500);
  const [updatedAt, setUpdatedAt] = useState("");

  useEffect(() => {
    const current = getVehicleMileage();
    setMileage(current.mileage);
    setUpdatedAt(current.updatedAt);

    function handleMileageUpdated(event: Event) {
      const customEvent = event as CustomEvent<{
        mileage: number;
        updatedAt: string;
      }>;

      if (!customEvent.detail) {
        return;
      }

      setMileage(customEvent.detail.mileage);
      setUpdatedAt(customEvent.detail.updatedAt);
    }

    window.addEventListener(
      "swm:vehicle-mileage-updated",
      handleMileageUpdated,
    );

    return () => {
      window.removeEventListener(
        "swm:vehicle-mileage-updated",
        handleMileageUpdated,
      );
    };
  }, []);

  return (
    <main className={styles.shell}>
      <header className={styles.header}>
        <div>
          <p>SWM Care Mobile</p>
          <h1>Perfil</h1>
        </div>

        <div className={styles.avatar} aria-hidden="true">
          WV
        </div>
      </header>

      <section className={styles.content}>
        <article className={styles.vehicleCard}>
          <div className={styles.vehicleTop}>
            <div>
              <span className={styles.vehicleLabel}>Mi vehículo</span>
              <h2>SWM G01</h2>
              <p>2022 · Turbo · Manual</p>
            </div>

            <div className={styles.vehiclePhoto}>
              <img src="/swm-g01.png" alt="SWM G01" />
            </div>
          </div>

          <div className={styles.vehicleStats}>
            <div>
              <span>Kilometraje</span>
              <strong>{formatMileage(mileage)} km</strong>
            </div>

            <div>
              <span>Actualizado</span>
              <strong>{formatUpdatedAt(updatedAt)}</strong>
            </div>
          </div>

          <div className={styles.status}>
            <span />
            Vehículo registrado
          </div>
        </article>

        <section className={styles.menu} aria-label="Opciones del perfil">
          {menuItems.map(({ label, description, icon: Icon }) => (
            <button className={styles.menuItem} type="button" key={label}>
              <span className={styles.menuIcon}>
                <Icon size={21} />
              </span>

              <span className={styles.menuText}>
                <strong>{label}</strong>
                <small>{description}</small>
              </span>

              <ChevronRight className={styles.chevron} size={20} />
            </button>
          ))}
        </section>

        <p className={styles.version}>SWM Care Mobile · Versión 1.0</p>
      </section>

      <BottomNavigation />
    </main>
  );
}
